# Copy to ".env" if you need overrides. Models live in LM Studio (or a cloud host);
# pick them on the Models page. CatCrewAI does not download or run models itself.
# CATCREW_HOME=C:\CatCrewAI
# CATCREW_SEARXNG_URL=
# Extra instances, comma-separated
# CATCREW_SEARXNG_URLS=

# ComfyUI (image gen, separate from the chat LLM). Empty URL = auto-detect 8188 then 8000.
# CatCrewAI starts a hidden `python main.py` from the Desktop install — not Comfy Desktop.exe.
# CATCREW_COMFYUI_URL=http://127.0.0.1:8188
# CATCREW_COMFYUI_ROOT=C:\ComfyUI

# Optional API keys: prefer the Models page (hosts) and Settings → API Access (Brave).
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# CATCREW_BRAVE_KEY=

# Command timeout and tool rounds: Settings → General (data/settings.json), not here.
# A chat over this many tokens (about 4 characters each) is summarised by the Memory model
# before it goes to the next model. Recent turns stay word for word.
# CATCREW_CONTEXT_TOKENS=8000
# CATCREW_COMPACT_KEEP=10

# Rare env fallback only. Live workspace roots come from the session Files explorer
# (new chat starts empty; picker opens at C:\). Do not point this at the app install.
# CATCREW_WORKSPACE=

# Long-term memory (mem0, local)
# CATCREW_MEMORY_ENABLED=0

# API server (loopback only). The desktop shell expects port 8765.
# CATCREW_HOST=127.0.0.1
# CATCREW_PORT=8765
# Extra browser origins the API accepts, comma separated (Tauri and the Vite dev server are built in).
# CATCREW_ALLOWED_ORIGINS=
