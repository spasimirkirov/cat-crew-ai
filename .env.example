# Local llama-server (GGUF). Copy to ".env" if you need overrides.
# JINX_HOME=C:\Jinx-AI
# JINX_MODELS_DIR=C:\Jinx-AI\models
# JINX_BIN_DIR=C:\Jinx-AI\bin
# JINX_LLAMA_URL=http://127.0.0.1:8787
# JINX_LLAMA_PORT=8787
# Default context is 32768 in config.py; override only if you must.
# JINX_LLAMA_CTX=32768

# Optional Hugging Face token for gated GGUF downloads (Settings → API Access).
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
# JINX_SEARXNG_URL=
# Extra instances, comma-separated
# JINX_SEARXNG_URLS=

# ComfyUI (image gen, separate from the chat LLM). Empty URL = auto-detect 8188 then 8000.
# Jinx starts a hidden `python main.py` from the Desktop install — not Comfy Desktop.exe.
# JINX_COMFYUI_URL=http://127.0.0.1:8188
# JINX_COMFYUI_ROOT=C:\ComfyUI

# Optional API keys: prefer AI Models → Cloud API (chat) and Settings → API Access (Brave).
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# JINX_BRAVE_KEY=

# Command timeout and tool rounds: Settings → General (data/settings.json), not here.
# JINX_COMPACT_CHARS=80000
# JINX_COMPACT_KEEP=10

# Rare env fallback only. Live workspace roots come from the session Files explorer
# (new chat starts empty; picker opens at C:\). Do not point this at the app install.
# JINX_WORKSPACE=

# Desktop orb overlay (QPainter, no 3D). Set 0 to hide.
# JINX_AVATAR_ENABLED=1

# Memory / voice
# JINX_MEMORY_ENABLED=0
# JINX_TTS=0
