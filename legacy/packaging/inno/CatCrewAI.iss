; CatCrewAI Installer Script
; Generated by packager.py
; To build: open in Inno Setup Compiler or run: ISCC.exe CatCrewAI.iss

#define MyAppName "CatCrewAI"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "CatCrewAI"
#define MyAppURL "https://cat-crew-ai.local"

[Setup]
AppId={{8F1C2D3E-4A5B-6C7D-8E9F-0A1B2C3D4E5F}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes

; Write installer .exe to dist/ (writable location)
OutputDir=C:\Development\cat-crew-ai\dist
OutputBaseFilename=CatCrewAI-Setup

Compression=lzma2
SolidCompression=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop icon"; GroupDescription: "Additional icons:"
Name: "addtopath"; Description: "Add 'catcrew' to system PATH (enables terminal command)"; GroupDescription: "Command line access:"

[Files]
Source: "C:\Development\cat-crew-ai\dist\CatCrewAI.exe\CatCrewAI.exe"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\CatCrewAI.exe"
Name: "{group}\Uninstall {#MyAppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\CatCrewAI.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\CatCrewAI.exe"; Description: "Launch CatCrewAI"; Flags: postinstall nowait skipifsilent
