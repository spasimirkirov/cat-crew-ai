{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatCrewAI",
  "version": "0.1.0",
  "identifier": "ai.catcrew.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CatCrewAI",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0B0D12",
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "CatCrewAI"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http://127.0.0.1:8765; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765 ws://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
